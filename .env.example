# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# Claude Code CLI 구독 로그인 토큰 (`claude setup-token`으로 발급, 설계서 4.9)
CLAUDE_CODE_OAUTH_TOKEN=

# 음성 인식·합성 키 (3단계에서 서비스 결정 후 사용)
WHISPER_API_KEY=
TTS_API_KEY=

# 기본값을 바꿀 때만 지정
# DATABASE_URL는 기본값 server/trailtalk.db를 쓴다. 바꿀 때는 절대 경로로 지정한다.
# DEFAULT_PERSONA=jenny
