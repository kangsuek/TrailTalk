# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# Claude Code CLI 구독 로그인 토큰 (설계서 4.9, docs/spikes/claude-cli.md 8절)
# `claude setup-token`으로 발급해 붙여 넣는다. 키체인 로그인보다 우선하며 서버는 이 값만 쓴다.
# 서버가 CLI 자식 프로세스 환경으로만 전달하고 로그에 남기지 않는다.
CLAUDE_CODE_OAUTH_TOKEN=

# 음성 인식·합성 키 (OpenAI, 결정 D2·D3). 인식과 합성에 같은 키를 쓴다.
# 예전 이름 WHISPER_API_KEY도 받는다. 비어 있으면 서버는 시작하지만 음성 대화는 실패한다
OPENAI_API_KEY=

# 웹 검색 API 키 (Tavily, docs/tavily-search-plan.md). 매월 1,000크레딧 무료(카드 불필요).
# 제니의 search_USA 도구가 쓴다. 비어 있으면 내장 WebSearch로만 검색한다
TAVILY_API_KEY=

# 네이버 뉴스 검색 API (국내 뉴스, docs/naver-search-plan.md). 네이버 개발자 센터에서 애플리케이션을
# 등록(사용 API: 검색)하면 발급된다. search_naver 도구가 쓴다. 비어 있으면 내장 WebSearch로만 검색한다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 대화 내용 이메일 보내기(제니의 send_email 도구). 설정하지 않으면 도구가 보내지 못한다고 안내한다.
# 받는 주소는 설정 화면의 이메일 칸이고, 아래는 서버가 쓰는 보내는 메일 계정이다.
# Gmail이면 SMTP_HOST=smtp.gmail.com, 계정의 앱 비밀번호를 SMTP_PASSWORD에 넣는다.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=            # 비우면 SMTP_USER
# SMTP_SECURITY=starttls   # starttls(587) | ssl(465) | none

# 기본값을 바꿀 때만 지정
# CLAUDE_CLI_PATH=claude
# LLM_CHAT_MODEL=sonnet
# LLM_LIGHT_MODEL=haiku
# CLI_IDLE_TIMEOUT_S=600       # 이 시간 동안 쓰지 않은 CLI 프로세스는 닫고, 다음 턴에 --resume으로 되살린다
# CLI_TURN_TIMEOUT_S=120
# DATABASE_URL는 기본값 server/trailtalk.db를 쓴다. 바꿀 때는 절대 경로로 지정한다.
# DEFAULT_PERSONA=jenny
# STT_MODEL=gpt-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# FFMPEG_PATH=ffmpeg          # PATH에 없으면 절대 경로로 지정(예: ~/.local/bin/ffmpeg)
